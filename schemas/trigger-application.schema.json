{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shunk031/shuhari/schemas/trigger-application.schema.json",
  "title": "Shuhari trigger application artifact",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1" },
    "target_read": { "type": "boolean" },
    "verdict": { "enum": ["not_consulted", "applied", "declined", "ambiguous"] },
    "applied": { "type": "boolean" },
    "evidence": { "type": "string", "minLength": 1 }
  },
  "required": ["schema_version", "target_read", "verdict", "applied", "evidence"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "not_consulted" } }, "required": ["verdict"] },
      "then": { "properties": { "target_read": { "const": false }, "applied": { "const": false } } }
    },
    {
      "if": { "properties": { "verdict": { "enum": ["applied", "declined", "ambiguous"] } }, "required": ["verdict"] },
      "then": { "properties": { "target_read": { "const": true } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "applied" } }, "required": ["verdict"] },
      "then": { "properties": { "applied": { "const": true } } }
    },
    {
      "if": { "properties": { "verdict": { "enum": ["declined", "ambiguous"] } }, "required": ["verdict"] },
      "then": { "properties": { "applied": { "const": false } } }
    }
  ]
}

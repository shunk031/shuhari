{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shunk031/shuhari/schemas/benchmark.schema.json",
  "title": "Shuhari benchmark artifact",
  "type": "object",
  "properties": {
    "schema_version": { "const": "2" },
    "mode": { "enum": ["agentic", "completion"] },
    "security": { "oneOf": [{ "$ref": "#/$defs/security" }, { "type": "null" }] },
    "run_summary": { "type": "object" },
    "assertion_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": { "type": "string" },
          "assertion": { "type": "string" },
          "with_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "without_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "category": { "enum": ["always_pass_both", "always_fail_both", "pass_with_fail_without", "mixed"] }
        },
        "required": ["case_id", "assertion", "with_pass_rate", "without_pass_rate", "category"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "mode", "security", "run_summary", "assertion_analysis"],
  "additionalProperties": false,
  "$defs": {
    "security": {
      "type": "object",
      "properties": {
        "sandbox_level": { "enum": ["isolated", "read-only", "unsandboxed"] },
        "network_access": { "enum": ["denied", "allowed"] },
        "credential_boundary": { "enum": ["enforced", "none"] },
        "host_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "adapter": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "native_mode": { "type": "string", "minLength": 1 },
            "policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" }
          },
          "required": ["name", "native_mode", "policy_digest"],
          "additionalProperties": false
        }
      },
      "required": ["sandbox_level", "network_access", "credential_boundary", "adapter"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "sandbox_level": { "const": "unsandboxed" } }, "required": ["sandbox_level"] },
          "then": { "properties": { "network_access": { "const": "allowed" }, "credential_boundary": { "const": "none" } } }
        },
        {
          "if": { "properties": { "sandbox_level": { "enum": ["isolated", "read-only"] } }, "required": ["sandbox_level"] },
          "then": { "properties": { "credential_boundary": { "const": "enforced" } } }
        }
      ]
    }
  }
}

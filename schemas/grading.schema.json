{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shunk031/shuhari/schemas/grading.schema.json",
  "title": "Shuhari grading artifact",
  "type": "object",
  "properties": {
    "assertion_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1, "pattern": ".*[\"“”].*" },
          "absence": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "negated_clause": { "type": "string", "minLength": 1 },
                  "query": { "type": "string", "minLength": 1 },
                  "rationale": { "type": "string", "minLength": 1 }
                },
                "required": ["negated_clause", "query", "rationale"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "forbidden_patterns": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                },
                "required": ["forbidden_patterns"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["text", "passed", "evidence"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["passed", "failed", "total", "pass_rate"],
      "additionalProperties": false
    }
  },
  "required": ["assertion_results", "summary"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shunk031/shuhari/schemas/trigger.schema.json",
  "title": "Shuhari trigger verdict artifact",
  "type": "object",
  "properties": {
    "schema_version": { "const": "3" },
    "mode": { "enum": ["agentic", "completion"] },
    "security": { "oneOf": [{ "$ref": "#/$defs/security" }, { "type": "null" }] },
    "decision_rule": { "enum": ["majority", "strict"] },
    "passed": { "type": "boolean" },
    "target_read": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "boolean" }
      }
    },
    "target_applied": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "boolean" }
      }
    },
    "target_invoked": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "boolean" }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "invoke": { "type": "boolean" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "required": ["invoke", "reason"],
          "additionalProperties": false
        }
      }
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "string", "minLength": 1 }
  },
  "required": ["schema_version", "mode", "security", "decision_rule", "passed"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "agentic" } }, "required": ["mode"] },
      "then": {
        "required": ["target_read", "target_applied"],
        "not": { "required": ["target_invoked"] }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "completion" } }, "required": ["mode"] },
      "then": {
        "required": ["target_invoked"],
        "not": { "anyOf": [{ "required": ["target_read"] }, { "required": ["target_applied"] }] }
      }
    }
  ],
  "$defs": {
    "security": {
      "type": "object",
      "properties": {
        "sandbox_level": { "enum": ["isolated", "read-only", "unsandboxed"] },
        "network_access": { "enum": ["denied", "allowed"] },
        "credential_boundary": { "enum": ["enforced", "none"] },
        "host_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "adapter": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "native_mode": { "type": "string", "minLength": 1 },
            "policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" }
          },
          "required": ["name", "native_mode", "policy_digest"],
          "additionalProperties": false
        }
      },
      "required": ["sandbox_level", "network_access", "credential_boundary", "adapter"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "sandbox_level": { "const": "unsandboxed" } }, "required": ["sandbox_level"] },
          "then": { "properties": { "network_access": { "const": "allowed" }, "credential_boundary": { "const": "none" } } }
        },
        {
          "if": { "properties": { "sandbox_level": { "enum": ["isolated", "read-only"] } }, "required": ["sandbox_level"] },
          "then": { "properties": { "credential_boundary": { "const": "enforced" } } }
        }
      ]
    }
  }
}

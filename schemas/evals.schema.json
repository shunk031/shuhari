{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shunk031/shuhari/schemas/evals.schema.json",
  "title": "Shuhari evaluation suite",
  "type": "object",
  "properties": {
    "skill_name": { "type": "string", "minLength": 1 },
    "instructions_name": { "type": "string", "minLength": 1 },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "integer" }] },
          "prompt": { "type": "string", "minLength": 1 },
          "expected_output": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "assertions": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "forbidden_patterns": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  },
                  "required": ["text"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required_actions": {
            "type": "array",
            "items": { "enum": ["web_search", "github_search", "file_change"] }
          }
        },
        "required": ["id", "prompt", "expected_output"],
        "additionalProperties": false
      }
    }
  },
  "required": ["evals"],
  "oneOf": [
    { "required": ["skill_name"], "not": { "required": ["instructions_name"] } },
    { "required": ["instructions_name"], "not": { "required": ["skill_name"] } }
  ],
  "additionalProperties": false
}
